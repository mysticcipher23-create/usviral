# Public site URL used for sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Shown on the contact and privacy pages. Required before an AdSense review.
NEXT_PUBLIC_CONTACT_EMAIL=

# Your AdSense publisher id, including the ca- prefix: ca-pub-1234567890123456
# Leave blank until Google approves the site. Fake ids can cause invalid traffic.
NEXT_PUBLIC_ADSENSE_CLIENT=

# A display ad unit id from the AdSense dashboard. Ads render only when both values are set.
NEXT_PUBLIC_ADSENSE_SLOT=
